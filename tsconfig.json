{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "baseUrl": ".",
    "paths": {
        "@/*": ["./src/renderer/*"],
        "@shared/*": ["./src/shared/*"],
        "@main/*": ["./src/main/*"],
        "@preload/*": ["./src/preload/*"]
    },
    "typeRoots": ["node_modules/@types"],
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist*", "**/*.js"]
}