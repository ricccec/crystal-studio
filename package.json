{
  "name": "crystal-studio",
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "clean": "npx rimraf dist dist-electron out release",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "author": "Riccardo Cecchi",
  "license": "ISC",
  "description": "",
  "build": {
    "appId": "com.riccardocecchi.crystalstudio",
    "productName": "Crystal Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "electron": "^37.2.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "electron-builder": "^26.0.12",
    "rimraf": "^6.0.1",
    "vite": "^7.1.1",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^3.2.4"
  }
}
